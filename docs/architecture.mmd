    style UC_VOLUMES fill:#fff3e0,stroke:#FF9800
    style SETUP fill:#f3e5f5,stroke:#9C27B0
    style DIMS fill:#fce4ec,stroke:#E91E63
    style SDP fill:#e8f5e9,stroke:#4CAF50
    style AI fill:#e3f2fd,stroke:#1565C0
    style MODEL fill:#e3f2fd,stroke:#1565C0
    style OUTPUTS fill:#fafafa,stroke:#9E9E9E
